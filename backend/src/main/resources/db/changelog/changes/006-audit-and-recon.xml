<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <!-- ============================================================
         TICKET-ADV132 / ADV137 / ADV138
         audit_log table
         ============================================================ -->

    <changeSet id="006-create-audit-log" author="trainer">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="audit_log"/>
            </not>
        </preConditions>

        <createTable tableName="audit_log">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="event_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="trade_ref" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="event_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="event_timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="actor" type="VARCHAR(100)"/>

            <!-- JSON snapshots -->
            <column name="before_state" type="TEXT"/>

            <column name="after_state" type="TEXT"/>

        </createTable>

        <createIndex
                tableName="audit_log"
                indexName="idx_audit_log_trade_ref">

            <column name="trade_ref"/>

        </createIndex>

        <rollback>
            <dropTable tableName="audit_log"/>
        </rollback>

    </changeSet>



    <!-- ============================================================
         recon_breaks table
         ============================================================ -->

    <changeSet id="006-create-recon-breaks" author="trainer">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="recon_breaks"/>
            </not>
        </preConditions>

        <createTable tableName="recon_breaks">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="trade_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="discrepancy_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="status"
                    type="VARCHAR(20)"
                    defaultValue="OPEN">

                <constraints nullable="false"/>

            </column>

            <column name="detected_at"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="resolved_at"
                    type="TIMESTAMP"/>

            <column name="resolution_note"
                    type="VARCHAR(500)"/>

        </createTable>

        <!-- `trades` is range partitioned by trade_date and has the composite
             key (id, trade_date).  A single trade_id cannot be a PostgreSQL
             foreign key to that parent without storing trade_date here too.
             Keep the logical relationship and index it; application services
             validate the referenced trade until the child model is upgraded. -->
        <createIndex tableName="recon_breaks" indexName="idx_recon_breaks_trade_id">
            <column name="trade_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="recon_breaks"/>
        </rollback>

    </changeSet>



    <!-- ============================================================
         recon_jobs table
         ============================================================ -->

    <changeSet id="006-create-recon-jobs" author="trainer">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="recon_jobs"/>
            </not>
        </preConditions>

        <createTable tableName="recon_jobs">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="job_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="status"
                    type="VARCHAR(20)"
                    defaultValue="QUEUED"/>

            <column name="started_at"
                    type="TIMESTAMP"/>

            <column name="finished_at"
                    type="TIMESTAMP"/>

            <column name="trades_processed"
                    type="INT"
                    defaultValueNumeric="0"/>

            <column name="breaks_detected"
                    type="INT"
                    defaultValueNumeric="0"/>

        </createTable>

        <rollback>
            <dropTable tableName="recon_jobs"/>
        </rollback>

    </changeSet>
<changeSet id="011-create-recon-results" author="dbtraining">

    <createTable tableName="recon_results">

        <column name="id" type="BIGSERIAL">
            <constraints primaryKey="true"
                         nullable="false"/>
        </column>

        <column name="trade_ref" type="VARCHAR(30)">
            <constraints nullable="false"/>
        </column>

        <column name="status" type="VARCHAR(20)">
            <constraints nullable="false"/>
        </column>

    </createTable>


    <createIndex tableName="recon_results"
                 indexName="idx_recon_results_trade_ref">

        <column name="trade_ref"/>

    </createIndex>

</changeSet>
</databaseChangeLog>